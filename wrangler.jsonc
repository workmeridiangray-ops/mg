{
	// Pre-launch gate: this Worker script (src/index.js) runs in front of
	// the static site. While vars.GATE_ENABLED is "true", every request
	// (run_worker_first) is checked for a signed session cookie; without
	// one, visitors get a Coming Soon page with Google sign-in instead of
	// the real site. Approved emails see the real site via the ASSETS
	// binding below. To launch for real: flip GATE_ENABLED to "false"
	// (here, or as a dashboard variable override) and redeploy -- no code
	// removal needed.
	//
	// Secrets this Worker needs (Cloudflare dashboard -> Workers & Pages ->
	// mg -> Settings -> Variables and Secrets -- never in this repo):
	//   GOOGLE_CLIENT_SECRET
	//   SESSION_SECRET  (any long random string)
	"name": "mg",
	"compatibility_date": "2026-11-03",
	// Keep variables/secrets set in the Cloudflare dashboard across deploys.
	"keep_vars": true,
	"main": "src/index.js",
	"vars": {
		"GATE_ENABLED": "true",
		"GOOGLE_CLIENT_ID": "83114262692-t20h3npqkn8grlic4064fjgnprkqgouu.apps.googleusercontent.com",
		"PREVIEW_KEY": "yzNL2hTgZhs8UQ1c7p75IUPUB3rjgkkA",
		"ALLOWED_EMAILS": "work.meridiangray@gmail.com,mehtaambeshwar@gmail.com,ambheshwarmehta28@gmail.com,avnishpatel2191@gmail.com"
	},
	"assets": {
		"directory": ".",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"html_handling": "auto-trailing-slash",
		"run_worker_first": true
	}
}
